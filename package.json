    "name": "VELKEI Tamás (vt / cjvt) @inebhedj",
    "email": "inebhedj@inebhedj.hu",
    "url": "https://github.com/inebhedj/"
  },
  "license": "ISC",
  "keywords": [
    "git",
    "git-hooks",
    "githooks",
    "jira",
    "commit-message",
    "branch-name",
    "conventional-workflow",
    "versioning",
    "custom-hooks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inebhedj/ih-cgh.git"
  },
  "homepage": "https://inebhedj.hu/ih-cgh",
  "bugs": "https://github.com/inebhedj/ih-cgh/issues",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cgh": "bin/cgh"
  },
  "files": [
    "bin",
    "payload",
    "install.sh",
    "VERSION.md",
    "ISC-LICENSE.md"
  ],
  "scripts": {
    "test": "sh tests/run.sh",
    "publish:npm": "npm login && npm publish --access public"
  }
}
